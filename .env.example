# Copy NEVER. This file documents which secrets bin/push.sh needs.
# Real values live in your password manager / ~/.config, passed as env vars.
# Required: TAILSCALE_AUTHKEY (reusable key from tailscale admin console)
# Optional: BOX_HOSTNAME (default mc-gpu-01), HF_TOKEN (gated HF repos),
#   CIVITAI_TOKEN (free API key, kinder rate limits), COMFY_DIR (default
#   /workspace/ComfyUI), FORCE_COMFY_REV (default 0 — stay on template's
#   comfy unless you explicitly want the pinned rev), TORCH_CUDA (default
#   cu124 — bare-box fallback only, templates already ship torch).
TAILSCALE_AUTHKEY=
BOX_HOSTNAME=mc-gpu-01
HF_TOKEN=
CIVITAI_TOKEN=
COMFY_DIR=/workspace/ComfyUI
FORCE_COMFY_REV=0
TORCH_CUDA=cu124
