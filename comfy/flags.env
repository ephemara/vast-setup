# ComfyUI launch flags for cloud boxes. Bare boxes: sourced into run.sh
# (generated by bake.sh). Vast base-image boxes: supervisor owns the service —
# set these via COMFYUI_ARGS in ${WORKSPACE}/.env + `supervisorctl restart comfyui`.
# Universal profile — safe on any NVIDIA GPU. Arch-specific extras are guarded
# in bake.sh, never unconditionally added.
COMFY_PORT=8188
COMFY_ARGS="--listen 0.0.0.0 --port 8188 --enable-cors-header * --reserve-vram 0.5 --cuda-malloc --fp16-vae --disable-smart-memory"
# HARD RULES (bake.sh enforces, do not override here):
# - NEVER --use-sage-attention below sm_80 (Ampere+ only)
# - NEVER --fast fp16_accumulation with GGUF DiT (breaks Wan sampling)
# - Turing-or-older extras (--fp16-vae etc.) stay on the 6GB laptop, not here
